# Copy to .env.dev in the dev worktree. The .env.dev file is gitignored.
FLOWPILOT_ADMIN_WEB_PORT=3012
FLOWPILOT_RUNNER_PORT=4318
FLOWPILOT_DESKTOP_PORT=5174
# Optional: pin which linked worktree `just production` should launch.
# FLOWPILOT_PRODUCTION_WORKTREE=.linked-worktrees/flowpilot-main

# Optional explicit origins. The Justfile/supervisor derive these from the ports
# when omitted.
# FLOWPILOT_RUNNER_URL=http://127.0.0.1:4318
# VITE_LOCAL_RUNNER_URL=http://127.0.0.1:4318
# VITE_RUNNER_URL=http://127.0.0.1:4318
# VITE_ADMIN_WEB_URL=http://localhost:3012

# Google Drive OAuth must match the runner origin registered in Google Console.
# If omitted, the runner derives this from FLOWPILOT_RUNNER_URL.
# GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:4318/artifact-storage/google-drive/oauth/callback
