# Copy to .env in the main/production worktree. The .env file is gitignored.
FLOWPILOT_ADMIN_WEB_PORT=3002
FLOWPILOT_RUNNER_PORT=4317
FLOWPILOT_DESKTOP_PORT=5173

# Optional explicit origins. The Justfile/supervisor derive these from the ports
# when omitted.
# FLOWPILOT_RUNNER_URL=http://127.0.0.1:4317
# VITE_LOCAL_RUNNER_URL=http://127.0.0.1:4317
# VITE_RUNNER_URL=http://127.0.0.1:4317
# VITE_ADMIN_WEB_URL=http://localhost:3002

# Google Drive OAuth must match the runner origin registered in Google Console.
# If omitted, the runner derives this from FLOWPILOT_RUNNER_URL.
# GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:4317/artifact-storage/google-drive/oauth/callback
