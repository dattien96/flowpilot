{
  "name": "desktop-flowpilot",
  "version": "0.1.0",
  "private": true,
  "description": "FlowPilot desktop client (Electron + React)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:phase1": "tsc -p ../../tsconfig.phase1-tests.json && node --require ../../scripts/phase1-runtime.js --test ../../.phase1-tests/tests/phase1 ../../.phase1-tests/apps/desktop-flowpilot/src",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "predev": "node scripts/ensure-deps.js",
    "prebuild": "node scripts/ensure-deps.js",
    "pretypecheck": "node scripts/ensure-deps.js",
    "pretest:phase1": "node scripts/ensure-deps.js"
  },
  "build": {
    "appId": "com.flowpilot.desktop",
    "productName": "FlowPilot",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "20.19.41",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "5.9.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
