FROM node:22-bookworm AS node_runtime

FROM golang:1.26-bookworm

COPY --from=node_runtime /usr/local/ /usr/local/

WORKDIR /workspace/apps/local-runner

COPY apps/local-runner/go.mod apps/local-runner/go.sum ./

RUN go mod download && npm install -g @openai/codex@0.130.0

CMD ["go", "run", "./cmd/flowpilot", "--workspace", "/workspace", "runner", "serve", "--host", "0.0.0.0", "--port", "4317"]
